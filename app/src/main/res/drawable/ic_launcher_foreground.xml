    <!-- Adaptive-icon foreground. Everything must sit inside the centre 72x72 safe zone, so the
         mark spans exactly 18..90 on both axes and is centred on 54,54 — a launcher's circular
         mask crops hard, and a mark a few units low reads as a mistake rather than a style.
         A four-cell grid: three "on" days and one "off", which is what the app is about.
         Cells are 34 wide with a 4 gap: 34 + 4 + 34 = 72. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M22,18h26a4,4 0 0,1 4,4v26a4,4 0 0,1 -4,4h-26a4,4 0 0,1 -4,-4v-26a4,4 0 0,1 4,-4z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M60,18h26a4,4 0 0,1 4,4v26a4,4 0 0,1 -4,4h-26a4,4 0 0,1 -4,-4v-26a4,4 0 0,1 4,-4z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M22,56h26a4,4 0 0,1 4,4v26a4,4 0 0,1 -4,4h-26a4,4 0 0,1 -4,-4v-26a4,4 0 0,1 4,-4z" />
    <!-- The "off" day: outline only. The inner subpath winds the other way, so nonZero fill
         leaves it hollow. -->
